# ---------------------------------------------------------------------------
# Application environment. Copy to .env and fill in the values.
# .env is ignored by git; .env.example is committed.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# The connection string used by the application, the Prisma CLI and the
# container health check. It must use the schema "public".
DATABASE_URL="postgresql://medical_store:CHANGE_ME@db:5432/medical_store?schema=public"

# --- Application ------------------------------------------------------------
NODE_ENV="production"
# The public address of the site. Used for absolute links and for the
# same-origin check on state changing API requests.
APP_URL="https://pharmacy.example.in"
APP_NAME="Medical Store"

# --- Sessions ---------------------------------------------------------------
# Name of the session cookie. Change it if the same host serves more than one
# application.
SESSION_COOKIE_NAME="ms_session"
# Session lifetime in hours for customers and for staff.
SESSION_TTL_HOURS="12"
ADMIN_SESSION_TTL_HOURS="4"

# --- Login protection -------------------------------------------------------
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"
LOGIN_WINDOW_MINUTES="15"

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="120"

# --- File storage -----------------------------------------------------------
# "local" stores files on a mounted volume; "s3" uses any S3 compatible
# object store (AWS S3, MinIO, Cloudflare R2, ...).
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="/app/storage"

# Only used when STORAGE_DRIVER="s3".
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION=""
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_FORCE_PATH_STYLE="false"

# --- Uploads ----------------------------------------------------------------
MAX_PRODUCT_IMAGE_BYTES="2097152"
MAX_PRESCRIPTION_BYTES="10485760"

# --- Payments ---------------------------------------------------------------
# "sandbox" never moves money. "razorpay" uses the Razorpay adapter.
# Live payments stay off until the compliance checklist is complete AND the
# merchant account has been approved.
PAYMENT_PROVIDER="sandbox"
PAYMENT_LIVE="false"
PAYMENT_WEBHOOK_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
PAYMENT_RAZORPAY_KEY_ID=""
PAYMENT_RAZORPAY_KEY_SECRET=""
PAYMENT_RAZORPAY_WEBHOOK_SECRET=""
PAYMENT_CURRENCY="INR"

# --- Bootstrap --------------------------------------------------------------
# A one-time token that allows the bootstrap-admin command to run without an
# interactive terminal. Remove it after the first administrator exists.
ADMIN_BOOTSTRAP_TOKEN=""
